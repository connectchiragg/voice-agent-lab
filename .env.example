GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Open-weight LLM on Groq; reasoning "none" keeps first-token latency low.
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_LLM_REASONING=none
KOKORO_VOICE=af_heart
# Time zone the assistant treats as "here" for the current date and time.
ASSISTANT_TIMEZONE=Asia/Kolkata
