GROQ_API_KEY=
# Open-weight LLM on Groq. gpt-oss-120b uses tools reliably; qwen/qwen3.8-27b with
# reasoning "none" is ~250 ms faster but skipped tools on follow-up questions.
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_REASONING=low
# Hedge: if the model sends nothing for this long, also ask the fallback (empty disables it).
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
FIRST_TOKEN_DEADLINE_MS=600
# Speech: Deepgram Flux (speech-to-text and turn detection) and Aura-2 (text-to-speech).
DEEPGRAM_API_KEY=
# Default: api.in.deepgram.com, Deepgram's India region (lowest latency from Mumbai).
# Elsewhere use api.deepgram.com (US) or api.eu.deepgram.com.
DEEPGRAM_HOST=api.in.deepgram.com
DEEPGRAM_VOICE=aura-2-odysseus-en
# Flux end of turn: EndOfTurn above this confidence (0.5-1.0); EagerEndOfTurn, which
# starts the speculative LLM reply, above the eager one (0.3-0.9, empty disables it);
# EndOfTurn anyway after this much silence (500-60000 ms).
FLUX_EOT_THRESHOLD=0.7
FLUX_EAGER_EOT_THRESHOLD=0.4
FLUX_EOT_TIMEOUT_MS=3000
# Phone calls (Telnyx). All three must be set, or phone calls are refused. The API key
# (Bearer) sends Call Control commands; the public key (base64, portal: Keys & Credentials >
# Public Key) verifies webhook signatures; the stream URL is this server's /ws/telnyx.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_STREAM_URL=wss://valr.haciensus.com/ws/telnyx
# Phone audio both ways: L16 (16 kHz wideband, default) or PCMU (8 kHz, the fallback).
TELNYX_CODEC=L16
# L16 byte order, both ways: little (what Telnyx sends) or big (RTP network order).
TELNYX_L16_BYTE_ORDER=little
# 1: Telnyx records each call (dual-channel WAV) for debugging; $0.002/min.
TELNYX_RECORD=0
# Goodbye and hang up after this long (a trial account's hard cap is 600 s); calls at once.
TELNYX_MAX_CALL_S=540
TELNYX_MAX_CALLS=2
# Time zone the assistant treats as "here" for the current date and time.
ASSISTANT_TIMEZONE=Asia/Kolkata
# Native Postgres (see README): password for the voice_agent role.
POSTGRES_PASSWORD=
# WebRTC media relay: a Cloudflare Realtime TURN key (dashboard > Realtime > TURN Server).
# Without it calls offer public STUN only, which works on localhost but not behind NAT.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
# Per-call limit (TURN credentials expire a minute later) and concurrent WebRTC calls.
WEBRTC_MAX_CALL_S=900
WEBRTC_MAX_CALLS=4
# Caller memory (README): 0 turns it off.
CALLER_MEMORY=1
# Browser callers are identified only by a verified Cloudflare Access JWT for this
# Access application's AUD tag (Zero Trust > Access > Applications > voice > Overview).
# Unset: every browser caller is anonymous.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=https://small-brook-8402.cloudflareaccess.com
# Past this the call starts without the caller's memory.
CALLER_MEMORY_LOAD_TIMEOUT_MS=150
# A summary waits at most this long for no live call and Groq headroom.
CALLER_MEMORY_SUMMARY_WAIT_S=600
# Scheduled callbacks (README): the self-hosted Temporal server; unset turns callbacks off.
# Locally `temporal server start-dev`; on the VM temporal:7233 (deploy/temporal-setup.sh).
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=voice-agent-lab
# No callbacks in these hours, the caller's time: 21-9 is 9 pm to 9 am. Empty or off: any hour.
CALLBACK_QUIET_HOURS=off
# While the assistant speaks, short backchannel words ("sure", "uh huh") do not barge in.
# A turn started over our speech is held until its first words, or interrupts after the hold.
BACKCHANNEL_IGNORE=1
BACKCHANNEL_WORDS=okay, ok, sure, yeah, yes, yep, uh huh, mm, mhm, mm hmm, hmm, right, alright, got it, i see, cool, great, nice, oh, ah
BACKCHANNEL_HOLD_MS=350
# VALR interview assistant (README): the owner's keys get interview mode, nobody else.
VALR_OWNER_PHONE=
VALR_OWNER_EMAILS=
VALR_OWNER_NAME=Chirag
# Dashboard and OAuth admins (Access emails); empty: anyone Access lets in.
VALR_ADMIN_EMAILS=
# Private data (profile, evaluation), mounted read-only at /data on the VM.
VALR_PROFILE_PATH=data/profile.json
VALR_EVALUATION_PATH=data/evaluation.json
# TTS respellings {"Acmecorp": "Acme Corp"} (app/persona.py); default /data/pronounce.json.
VALR_PRONOUNCE_PATH=
# Google OAuth (gmail.readonly + calendar.readonly) and the key that encrypts its token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://valr.haciensus.com/oauth/google/callback
VALR_GMAIL_ACCOUNT=
VALR_TOKEN_KEY=
# Calendar fallback when OAuth is not connected (secret).
VALR_CALENDAR_ICS_URL=
VALR_GCAL_WEBHOOK=https://valr.haciensus.com/hooks/gcal
VALR_CALENDAR_SWEEP_HOURS=6
# Fathom recordings for R1 (research worker only: .env.research).
FATHOM_API_KEY=
# Notetakers (app/notetakers). Keys are normally pasted on the dashboard and stored
# encrypted with VALR_TOKEN_KEY; these environment keys are an optional fallback.
FIREFLIES_API_KEY=
GRANOLA_API_KEY=
# Webhook signing secrets (app .env), "whsec_..." (Standard Webhooks).
FATHOM_WEBHOOK_SECRET=
GRANOLA_WEBHOOK_SECRET=
# Optional: the evaluation hand-off for new recordings ("module:function").
VALR_EVAL_HOOK=app.profile.notetaker_hook:evaluate_recording
# Optional: the bot's @username for the dashboard's t.me link (else getMe).
TELEGRAM_BOT_USERNAME=
VALR_CONTEXT_TOKEN=
# Lead tracker (docs/leads.md): Gmail push via Pub/Sub, 30-day backfill on first enable.
VALR_LEADS=0
VALR_GMAIL_TOPIC=projects/framer-511620/topics/valr-gmail
VALR_GMAIL_SUBSCRIPTION=projects/framer-511620/subscriptions/valr-gmail-push
VALR_GMAIL_PUSH_SA=valr-gmail-push@framer-511620.iam.gserviceaccount.com
VALR_GMAIL_PUSH_AUDIENCE=https://valr.haciensus.com/hooks/gmail
VALR_LEADS_LLM_PER_DAY=300
VALR_LEADS_BACKFILL_DAYS=30
VALR_LEADS_BACKFILL_MAX=500
VALR_LEADS_POLL_MINUTES=30
VALR_PERFORMANCE_PATH=/data/performance.json
VALR_BRIEFINGS=1
VALR_BRIEFING_DIAL=1
# Telegram heads-up at T-30 instead of the automatic call (deploy/install-telegram.sh
# writes both secrets). The owner's chat is linked with the dashboard's /start code, or
# TELEGRAM_OWNER_CHAT_ID. VALR_AUTO_DIAL=1: dial at T-30 again (no heads-up).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
VALR_AUTO_DIAL=0
VALR_BRIEFING_DIALS_PER_DAY=12
VALR_INTERVIEW_JOBS_PER_DAY=30
VALR_INTERVIEW_MONTH_USD=40
VALR_INTERVIEW_JOB_USD=0.40
